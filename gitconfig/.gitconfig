[user]
	name = thuaung30
	email = thuhtetaung.d2@gmail.com
[alias]
    c = commit -m
    ci = commit -m
    s = status
    st = status
    last = log -1 HEAD
    lg = log --oneline
    lgg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
    f = push --force-with-lease
[core]
	editor = vim
	autocrlf = input
[init]
	templateDir = /Users/thuhtetaung/.git-template
[credential]
	UseHttpPath = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[includeIf "gitdir:~/Work/"]
    path = ~/Work/.gitconfig
